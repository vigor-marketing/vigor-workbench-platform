# 示例：请按实际域名、容器名和端口替换。
server {
  listen 443 ssl http2;
  server_name workbench.example.com;

  location / {
    proxy_pass http://workbench-web:4173;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location /apps/ai-sales-coach/ {
    proxy_pass http://ai-sales-coach-web:5173/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Prefix /apps/ai-sales-coach;
  }

  location /apps/product-encoder/ {
    proxy_pass http://product-encoder-web:3000/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Prefix /apps/product-encoder;
  }

  location /apps/sales-commission/ {
    proxy_pass http://sales-commission-web:3000/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Prefix /apps/sales-commission;
  }

  # 建议在每个模块自身的响应中设置。这里只是关键规则的提醒：
  # Content-Security-Policy: frame-ancestors 'self' https://workbench.example.com;
  # 禁止 X-Frame-Options: DENY / SAMEORIGIN（若模块和平台为同一 origin，可用 SAMEORIGIN）。
}
