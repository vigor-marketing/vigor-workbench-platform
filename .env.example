# 注意：前端构建必须带 VITE_* 环境变量，否则嵌入应用会显示「等待网关地址配置」。
# 生产环境由同域 Nginx 反向代理提供；不要填 GitHub 地址或第三方页面地址。
# 例如：https://workbench.example.com/apps/ai-sales-coach/
VITE_APP_AI_SALES_COACH_URL=/apps/ai-sales-coach/
VITE_APP_PRODUCT_ENCODER_URL=/apps/product-encoder/
VITE_APP_SALES_COMMISSION_URL=/apps/sales-commission/
VITE_APP_KNOWLEDGE_BASE_URL=/apps/knowledge-base/

# 接入真实身份认证后设置；当前前端仅使用演示身份，不能作为权限边界。
VITE_AUTH_ISSUER=
VITE_PLATFORM_API_BASE=/api

# BFF（apps/bff）
PORT=4000
DATABASE_URL=postgres://workbench:change-me@localhost:5432/workbench
# 腾讯云 PostgreSQL 或其他生产数据库必须使用 TLS。CA 文件不能提交到 Git。
DATABASE_SSL=false
DATABASE_SSL_CA_PATH=
DATABASE_SSL_SERVERNAME=

# Set TODO_STORAGE=cloudbase-pg for the existing CloudBase PostgreSQL environment.
# Supply cloud credentials only through the CloudBase secret manager / runtime variables.
TODO_STORAGE=postgres
CLOUDBASE_ENV_ID=
CLOUDBASE_PG_ROLE=vigor_workbench_app
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
DEMO_MODE=true
ALLOWED_ORIGINS=http://localhost:4173
